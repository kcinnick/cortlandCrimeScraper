# Database Configuration
DATABASE_USERNAME=your_postgres_username
DATABASE_PASSWORD=your_postgres_password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4.1-mini

# Cortland Standard subscription login (optional for stored Voice articles)
LOGIN_EMAIL=your_login_email
LOGIN_PASSWORD=your_login_password

# Flask Configuration (defaults to development, read-only)
# Valid values: 'development', 'dev', 'test', 'production'
# DATABASE_ENV=development
# APP_READ_ONLY=1
# FLASK_SECRET_KEY=generate_a_random_secret_locally
# FLASK_ADMIN_TOKEN=generate_a_separate_random_token_locally

# The preview launcher always disables debug mode and binds to loopback.

